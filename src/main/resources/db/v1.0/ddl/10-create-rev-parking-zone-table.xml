<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="10" author="AnutaVacsh">
        <createTable tableName="rev_parking_zone">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_rev_parking_zone_id"/>
            </column>
            <column name="id_parking_zone" type="BIGINT">
                <constraints nullable="true" references="parking_zone(id)" foreignKeyName="fk_rev_parking_zone_zone"/>
            </column>
            <column name="id_client" type="BIGINT">
                <constraints nullable="true" references="users(id)" foreignKeyName="fk_rev_parking_zone_client"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="rating" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
