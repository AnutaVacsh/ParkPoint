<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="12" author="AnutaVacsh">
        <createTable tableName="subscription_days">
            <column name="subscription_id" type="BIGINT">
                <constraints nullable="false" references="subscription(id)" foreignKeyName="fk_subscription_days_subscription"/>
            </column>
            <column name="day_of_weak" type="INTEGER"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
