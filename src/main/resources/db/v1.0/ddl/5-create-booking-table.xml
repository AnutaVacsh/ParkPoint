<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="5" author="AnutaVacsh">
        <createTable tableName="booking">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_booking_id"/>
            </column>
            <column name="id_client" type="BIGINT">
                <constraints nullable="true" references="user(id)" foreignKeyName="fk_booking_client"/>
            </column>
            <column name="id_parking_space" type="BIGINT">
                <constraints nullable="true" references="parking_space(id)" foreignKeyName="fk_booking_space"/>
            </column>
            <column name="start_time" type="TIMESTAMP"/>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="date_created" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
