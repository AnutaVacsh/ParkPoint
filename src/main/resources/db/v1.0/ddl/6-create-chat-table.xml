<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="6" author="AnutaVacsh">
        <createTable tableName="chat">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_chat_id"/>
            </column>
            <column name="id_owner" type="BIGINT">
                <constraints nullable="true" references="users(id)" foreignKeyName="fk_chat_owner"/>
            </column>
            <column name="id_client" type="BIGINT">
                <constraints nullable="true" references="users(id)" foreignKeyName="fk_chat_client"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
