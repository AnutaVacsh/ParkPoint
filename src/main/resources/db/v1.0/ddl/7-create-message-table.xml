<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="7" author="AnutaVacsh">
        <createTable tableName="message">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_message_id"/>
            </column>
            <column name="id_chat" type="BIGINT">
                <constraints nullable="true" references="chat(id)" foreignKeyName="fk_message_chat"/>
            </column>
            <column name="id_sender" type="BIGINT">
                <constraints nullable="true" references="user(id)" foreignKeyName="fk_message_sender"/>
            </column>
            <column name="id_recipient" type="BIGINT">
                <constraints nullable="true" references="user(id)" foreignKeyName="fk_message_recipient"/>
            </column>
            <column name="content" type="TEXT"/>
            <column name="time" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
