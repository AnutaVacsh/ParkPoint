<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="3" author="AnutaVacsh">
        <createTable tableName="parking_zone">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_parking_zone_id"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="latitude" type="DOUBLE PRECISION"/>
            <column name="longitude" type="DOUBLE PRECISION"/>
            <column name="state" type="VARCHAR(50)"/>
            <column name="description" type="TEXT"/>
            <column name="map" type="TEXT"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
